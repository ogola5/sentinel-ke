# =============================================================================
# Sentinel-KE — Agency Edge Station Example Environment
# =============================================================================
# Copy this file to .env.edge on the AGENCY station:
#
#   cp .env.edge.example .env.edge
#   docker compose --env-file .env.edge -f docker-compose.edge.yml up -d --build
#
# This file is for the LOCAL agency stack only.
# Do not reuse the central hub .env on an agency station.
# =============================================================================

APP_ENV=development

# -----------------------------------------------------------------------------
# Local edge database / stream
# -----------------------------------------------------------------------------
EDGE_BACKEND_PORT=18000
EDGE_FRONTEND_PORT=13000
EDGE_POSTGRES_PORT=15433
EDGE_KAFKA_PORT=19092
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinel
REDPANDA_BROKERS=redpanda:9092

# -----------------------------------------------------------------------------
# Core API / browser auth
# -----------------------------------------------------------------------------
API_AUTH_DISABLED=false
API_AUTH_OPTIONAL_DEV=false
CORS_ALLOW_ORIGINS=http://localhost:13000
FRONTEND_API_KEY=replace-with-long-edge-frontend-api-key
INGEST_API_KEY=replace-with-long-edge-ingest-api-key
PSEUDONYM_SALT=replace-with-edge-pseudonym-salt-32chars

# -----------------------------------------------------------------------------
# Local analyst login for the agency station
# -----------------------------------------------------------------------------
AUTH_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=edge_admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=EdgeDemo2026!
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Agency Edge Admin
AUTH_CENTRAL_MFA_REQUIRED=false
AUTH_CENTRAL_MFA_ENROLLMENT_REQUIRED=false
AUTH_TOKEN_SECRET=replace-with-edge-auth-token-secret-32chars
AUTH_PASSWORD_PEPPER=replace-with-edge-password-pepper-16chars
AUTH_MFA_SECRET_KEY=replace-with-edge-mfa-secret-key-32chars
AUTH_PASSWORD_ITERATIONS=450000

# -----------------------------------------------------------------------------
# Edge station identity and hub sync
# Values returned by POST /v1/federation/register on the CENTRAL hub.
# -----------------------------------------------------------------------------
IS_EDGE_NODE=true
EDGE_PARTNER_ID=safaricom-ke
EDGE_HUB_URL=https://your-central-hub.example
EDGE_HUB_API_KEY=replace-with-hub-issued-partner-api-key
EDGE_NATIONAL_SALT=replace-with-hub-correlation-salt

# -----------------------------------------------------------------------------
# Edge scoring / sync tuning
# -----------------------------------------------------------------------------
GNN_WINDOW_KEY=Wmid
GNN_EDGE_BACKEND=postgres
AI_INFERENCE_ALLOW_HEURISTIC_FALLBACK=true
EDGE_SYNC_MIN_RISK=60
EDGE_SYNC_BATCH_SIZE=200
EDGE_SYNC_LOOKBACK_HOURS=4
EDGE_SYNC_INTERVAL_SECONDS=120
EDGE_GRAPH_INTERVAL_SECONDS=300
EDGE_INFERENCE_INTERVAL_SECONDS=300
EDGE_PATTERN_INTERVAL_SECONDS=300
EDGE_FUSION_INTERVAL_SECONDS=600
