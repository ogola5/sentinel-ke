# Sentinel-KE Edge Agent — environment variables
# Copy to .env and fill in the values before starting the container.

# ---- Identity ---------------------------------------------------------------
PARTNER_ID=equity-bank-ke
PARTNER_NAME=Equity Bank Kenya

# ---- National Hub connection -----------------------------------------------
# HUB_URL is the base URL of the Sentinel-KE national hub API.
HUB_URL=https://sentinel-ke.onrender.com
# HUB_API_KEY is issued by the hub admin via POST /v1/federation/register.
# Store it securely — it cannot be retrieved after initial registration.
HUB_API_KEY=REPLACE_WITH_KEY_FROM_REGISTRATION

# ---- GNN / inference settings ----------------------------------------------
WINDOW_HOURS=1
RUN_INTERVAL_S=300
RISK_THRESHOLD=0.60
MODEL_VERSION=edge-gnn-v1.0

# ---- Data source -----------------------------------------------------------
# Options: demo | csv | postgres
DATA_SOURCE=demo

# If DATA_SOURCE=csv:
# CSV_PATH=/data/events.csv

# If DATA_SOURCE=postgres (your own local bank/telco DB — data NEVER leaves):
# LOCAL_DB_URL=postgresql://user:pass@localhost:5432/partner_events

# ---- Privacy ---------------------------------------------------------------
# NATIONAL_SALT: the shared correlation salt returned by the hub when you
# registered via POST /v1/federation/register (field: correlation_salt).
# ALL partners use the SAME national salt so that the same entity (e.g. phone
# number) hashes identically at every edge agent — this is what makes
# cross-partner threat correlation possible on the hub.
# Copy the value from the registration response: edge_agent_env.NATIONAL_SALT
NATIONAL_SALT=REPLACE_WITH_CORRELATION_SALT_FROM_HUB_REGISTRATION

# HMAC_SALT: your own per-partner local secret. Used only for internal data
# processing that must remain opaque between partners. Never sent to the hub.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SALT=REPLACE_WITH_UNIQUE_SECRET_PER_PARTNER
