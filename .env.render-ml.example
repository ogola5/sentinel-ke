# Sentinel-KE local ML against Render Postgres
#
# Copy to: .env.render-ml
# Then use it when running your local heavy workers so they write to the same
# database that the Render backend reads from.

# Use the EXTERNAL database URL from Render Postgres.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/sentinel?sslmode=require

APP_ENV=production
PYTHONPATH=/app
KAFKA_ENABLED=false
GNN_ENABLED=true
AI_API_ENABLED=true
GNN_EDGE_BACKEND=postgres

# Render runtime-only deployment disables these optional services by default.
# Keep them disabled here unless you intentionally connect your local workers
# to managed OpenSearch / Neo4j instances.
OPENSEARCH_HOST=disabled
NEO4J_URI=disabled

# Reuse the same salts / secrets if your local workers need authenticated API
# calls back into the deployed backend. Direct DB writers do not usually need
# the auth values below.
FRONTEND_API_KEY=
INGEST_API_KEY=
PSEUDONYM_SALT=
AUTH_TOKEN_SECRET=
AUTH_PASSWORD_PEPPER=
AUTH_MFA_SECRET_KEY=
