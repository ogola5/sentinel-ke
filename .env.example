# Backend
APP_ENV=development
APP_NAME=Sentinel-Ke

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=eVANCE$1997
# OpenSearch
OPENSEARCH_HOST=http://opensearch:9200

# Redpanda / Kafka
KAFKA_BROKER=redpanda:9092
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX_EVENTS=sentinel-events-v1
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinel
# Redpanda / Kafka
REDPANDA_BROKERS=redpanda:9092SELECT id, api_key, source_type, classification, enabled


KAFKA_CLIENT_ID=sentinel-backend
KAFKA_EVENTS_TOPIC=sentinel.events.v1
KAFKA_GRAPH_TOPIC=sentinel.graph.delta.v1
KAFKA_ACKS=1
KAFKA_LINGER_MS=5
KAFKA_RETRIES=3
KAFKA_ENABLED=true

# Legal evidence anchoring (Phase 3)
# MinIO modes: stub | webhook | s3 | disabled
MINIO_ANCHOR_MODE=stub
MINIO_ANCHOR_BUCKET=sentinel-legal-evidence
MINIO_ANCHOR_WEBHOOK_URL=
MINIO_ANCHOR_TIMEOUT_SEC=5
MINIO_S3_ENDPOINT=minio:9000
MINIO_S3_REGION=us-east-1
MINIO_S3_ACCESS_KEY=minioadmin
MINIO_S3_SECRET_KEY=minioadmin
MINIO_S3_SECURE=false
MINIO_S3_CREATE_BUCKET_IF_MISSING=false
MINIO_OBJECT_LOCK_RETENTION_DAYS=365
MINIO_OBJECT_LEGAL_HOLD=true

# immudb modes: stub | webhook | http | disabled
IMMUDB_ANCHOR_MODE=stub
IMMUDB_ANCHOR_WEBHOOK_URL=
IMMUDB_HTTP_BASE_URL=
IMMUDB_HTTP_ANCHOR_PATH=/api/v2/anchor
IMMUDB_HTTP_TOKEN=
IMMUDB_ANCHOR_TIMEOUT_SEC=5

# GNN backbone (Neo4j + Postgres hybrid graph learning)
GNN_ENABLED=true
GNN_MODEL_VERSION=gnn-sage-v1
GNN_PREDICTION_TYPE=risk_gnn
GNN_WINDOW_KEY=Wmid
GNN_EDGE_BACKEND=hybrid
GNN_MAX_ENTITIES=3000
GNN_MAX_EDGES=30000
GNN_MIN_EDGE_WEIGHT=1
GNN_EPOCHS=60
GNN_HIDDEN_DIM=64
GNN_EMBED_DIM=32
GNN_DROPOUT=0.2
GNN_LEARNING_RATE=0.001
GNN_WEIGHT_DECAY=0.0001
GNN_SEED=7
GNN_ARTIFACT_DIR=/app/artifacts/gnn
