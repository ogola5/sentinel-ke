# App
APP_ENV=development
APP_NAME=Sentinel-KE

# API auth hardening
# In strict envs (APP_ENV=production/staging), short/missing values fail startup.
API_AUTH_DISABLED=false
API_AUTH_OPTIONAL_DEV=false
FRONTEND_API_KEY=change-me-frontend-key
INGEST_API_KEY=change-me-ingest-key
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
HTTP_SECURITY_HEADERS_ENABLED=true
HTTP_REQUEST_LOGGING_ENABLED=true

# User login + RBAC auth
AUTH_ENABLED=true
AUTH_ACCESS_TOKEN_MINUTES=20
AUTH_REFRESH_TOKEN_MINUTES=1440
AUTH_PASSWORD_ITERATIONS=450000
AUTH_PASSWORD_PEPPER=change-me-long-random-pepper
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCK_MINUTES=30
AUTH_TOKEN_ISSUER=sentinel-ke-auth
AUTH_TOKEN_AUDIENCE=sentinel-ke-api
AUTH_TOKEN_SECRET=change-me-long-random-token-secret
AUTH_MFA_ISSUER=Sentinel-KE
AUTH_MFA_SECRET_KEY=change-me-long-random-mfa-master-secret
AUTH_STEP_UP_MINUTES=15
AUTH_CENTRAL_MFA_REQUIRED=true
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_USERNAME=central-admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Central Admin

# Crypto posture + quantum readiness flags
CRYPTO_TLS_MODE=tls1.3
CRYPTO_PQC_MODE=hybrid
CRYPTO_KMS_PROVIDER=hsm
CRYPTO_KEY_ROTATION_DAYS=90

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinel

# Schema bootstrap: true for local dev only; false in staging/prod
DB_AUTO_CREATE=true

# Data privacy hardening
PSEUDONYM_SALT=change-me-long-random-salt

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_AUTH=neo4j/change-me-neo4j-password

# OpenSearch
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX_EVENTS=sentinel-events-v1

# Redpanda / Kafka
REDPANDA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=sentinel-backend
KAFKA_EVENTS_TOPIC=sentinel.events.v1
KAFKA_GRAPH_TOPIC=sentinel.graph.delta.v1
KAFKA_ACKS=1
KAFKA_LINGER_MS=5
KAFKA_RETRIES=3
KAFKA_ENABLED=true

# Legal authorization approvals
LEGAL_APPROVER_SECRETS=approver_a=change-me-a,approver_b=change-me-b

# Legal evidence anchoring (Phase 3)
# MinIO modes: stub | webhook | s3 | disabled
MINIO_ANCHOR_MODE=stub
MINIO_ANCHOR_BUCKET=sentinel-legal-evidence
MINIO_ANCHOR_WEBHOOK_URL=
MINIO_ANCHOR_TIMEOUT_SEC=5
MINIO_S3_ENDPOINT=minio:9000
MINIO_S3_REGION=us-east-1
MINIO_S3_ACCESS_KEY=change-me-minio-access-key
MINIO_S3_SECRET_KEY=change-me-minio-secret-key
MINIO_S3_SECURE=false
MINIO_S3_CREATE_BUCKET_IF_MISSING=false
MINIO_OBJECT_LOCK_RETENTION_DAYS=365
MINIO_OBJECT_LEGAL_HOLD=true

# immudb modes: stub | webhook | http | disabled
IMMUDB_ANCHOR_MODE=stub
IMMUDB_ANCHOR_WEBHOOK_URL=
IMMUDB_HTTP_BASE_URL=
IMMUDB_HTTP_ANCHOR_PATH=/api/v2/anchor
IMMUDB_HTTP_TOKEN=
IMMUDB_ANCHOR_TIMEOUT_SEC=5

# GNN backbone (Neo4j + Postgres hybrid graph learning)
GNN_ENABLED=true
AI_API_ENABLED=true
GNN_MODEL_VERSION=gnn-sage-v1
GNN_PREDICTION_TYPE=risk_gnn
GNN_WINDOW_KEY=Wmid
GNN_EDGE_BACKEND=hybrid
GNN_MAX_ENTITIES=3000
GNN_MAX_EDGES=30000
GNN_MIN_EDGE_WEIGHT=1
GNN_NEGATIVE_MULTIPLIER=1.5
GNN_EPOCHS=60
GNN_HIDDEN_DIM=64
GNN_EMBED_DIM=32
GNN_DROPOUT=0.2
GNN_LEARNING_RATE=0.001
GNN_WEIGHT_DECAY=0.0001
GNN_THRESHOLD_MIN_SAMPLES=10
GNN_COMPONENT_DISCOVERY_ENABLED=true
GNN_COMPONENT_MIN_SIZE=3
GNN_COMPONENT_MIN_INDICATOR_RATIO=0.5
GNN_SEED=7
GNN_ARTIFACT_DIR=/app/artifacts/gnn

# Live OSINT ingestion workers
FEODO_SOURCE_API_KEY=feodo-live-secret-key
FEODO_FEED_URL=https://feodotracker.abuse.ch/downloads/ipblocklist_recommended.json
FEODO_POLL_SEC=300
FEODO_TIMEOUT_SEC=30

URLHAUS_SOURCE_API_KEY=urlhaus-live-secret-key
URLHAUS_FEED_URL=https://urlhaus.abuse.ch/downloads/csv_online/
URLHAUS_AUTH_KEY=
URLHAUS_EVENT_MAX_RECORDS=400
URLHAUS_EVENT_SLEEP_EVERY=400
URLHAUS_EVENT_SLEEP_SEC=65
URLHAUS_POLL_SEC=900
URLHAUS_TIMEOUT_SEC=30

OTX_SOURCE_API_KEY=otx-live-secret-key
OTX_API_KEY=
OTX_SUBSCRIBED_URL=https://otx.alienvault.com/api/v1/pulses/subscribed
OTX_LIMIT=100
OTX_EVENT_MAX_RECORDS=400
OTX_EVENT_SLEEP_EVERY=400
OTX_EVENT_SLEEP_SEC=65
OTX_POLL_SEC=1800
OTX_TIMEOUT_SEC=30

# Local analyst query engine / legal packaging
AI_COPILOT_ENABLED=true
AI_COPILOT_MODEL=sentinel-local-analyst-v1
AI_COPILOT_MAX_TOKENS=1024
LEGAL_AUTO_BUNDLE_ENABLED=true
LEGAL_AUTO_BUNDLE_LIMIT=50

# Docker build profile
# 0 = backend/worker images skip torch (fast, good for API-only deploy)
# 1 = install torch in backend image (needed only if backend itself does ML training)
INSTALL_ML_IN_BACKEND=0
# 0 = use split install strategy (runtime/dev + optional ML)
# 1 = install full dependency bundle from backend/requirements.txt in one shot
#     (BUILD-ONCE default: set to 1 — torch+dev+runtime in a single build)
INSTALL_ALL_REQUIREMENTS=1

# Jupyter Lab (Docker notebook service)
JUPYTER_TOKEN=change-me-jupyter-token
