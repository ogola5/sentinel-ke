# =============================================================================
# Sentinel-KE — Render Backend-Only Environment (NO ML pipeline)
# Copy/paste these into Render -> Service -> Environment.
# =============================================================================

# --- Core runtime ---
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_AUTO_CREATE=false
PYTHONUNBUFFERED=1

# --- Feature flags (backend-only, no training/inference workers) ---
KAFKA_ENABLED=false
GNN_ENABLED=false
AI_API_ENABLED=false
GNN_EDGE_BACKEND=postgres

# --- Auth/API security (required by runtime hardening) ---
API_AUTH_DISABLED=false
INGEST_ALLOW_UNAUTH=false
AUTH_ENABLED=true
FRONTEND_API_KEY=REPLACE_WITH_32PLUS_CHAR_SECRET_KEY_1234567890
INGEST_API_KEY=REPLACE_WITH_32PLUS_CHAR_SECRET_KEY_0987654321
PSEUDONYM_SALT=REPLACE_WITH_24PLUS_CHAR_SALT_123456

# --- User auth + bootstrap admin ---
AUTH_TOKEN_SECRET=REPLACE_WITH_64HEX_TOKEN_SECRET_1234567890ABCDEF1234567890ABCDEF
AUTH_PASSWORD_PEPPER=REPLACE_WITH_24PLUS_CHAR_PASSWORD_PEPPER_123
AUTH_MFA_SECRET_KEY=REPLACE_WITH_64HEX_MFA_SECRET_ABCDEF1234567890ABCDEF1234567890
AUTH_PASSWORD_ITERATIONS=450000
AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Sentinel Admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
AUTH_TOKEN_ISSUER=sentinel-ke-auth
AUTH_TOKEN_AUDIENCE=sentinel-ke-api
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_REFRESH_TOKEN_MINUTES=10080
AUTH_CENTRAL_MFA_REQUIRED=false

# --- Network/security hardening ---
HTTP_SECURITY_HEADERS_ENABLED=true
HTTP_REQUEST_LOGGING_ENABLED=true
CORS_ALLOW_ORIGINS=https://your-frontend-domain.com

# --- Crypto posture baseline ---
CRYPTO_TLS_MODE=tls1.3
CRYPTO_PQC_MODE=hybrid
CRYPTO_KMS_PROVIDER=hsm
CRYPTO_KEY_ROTATION_DAYS=90

# --- Legal/audit controls ---
LEGAL_APPROVER_SECRETS=approver_a=REPLACE_WITH_LONG_SECRET_A,approver_b=REPLACE_WITH_LONG_SECRET_B
FEDERATION_CORRELATION_SALT=REPLACE_WITH_32PLUS_CHAR_NATIONAL_SALT_1234567890

# --- Optional external services (safe defaults) ---
OPENSEARCH_HOST=disabled
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
MINIO_ANCHOR_MODE=stub
IMMUDB_ANCHOR_MODE=stub
