APP_ENV=development

EDGE_BACKEND_PORT=18000
EDGE_FRONTEND_PORT=13000
EDGE_POSTGRES_PORT=15433
EDGE_KAFKA_PORT=19092
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgres:5432/sentinel
REDPANDA_BROKERS=redpanda:9092
OPENSEARCH_HOST=disabled

API_AUTH_DISABLED=false
API_AUTH_OPTIONAL_DEV=false
CORS_ALLOW_ORIGINS=http://localhost:13000
FRONTEND_API_KEY=edge-frontend-demo-key-2026-very-long
INGEST_API_KEY=edge-ingest-demo-key-2026-very-long
PSEUDONYM_SALT=edge-pseudonym-salt-demo-2026-32chars

AUTH_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=edge_admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=EdgeDemo2026!
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Agency Edge Admin
AUTH_CENTRAL_MFA_REQUIRED=false
AUTH_CENTRAL_MFA_ENROLLMENT_REQUIRED=false
AUTH_TOKEN_SECRET=edge-auth-token-secret-demo-2026-32chars
AUTH_PASSWORD_PEPPER=edge-password-pepper-demo
AUTH_MFA_SECRET_KEY=edge-mfa-secret-key-demo-2026-32chars
AUTH_PASSWORD_ITERATIONS=450000

IS_EDGE_NODE=true
EDGE_PARTNER_ID=safaricom-ke
EDGE_HUB_URL=http://sentinel-ke-backend-1:8000
EDGE_HUB_API_KEY=saf-telco-api-key-demo-2026
EDGE_NATIONAL_SALT=ke-sentinel-national-demo-salt-2026

GNN_WINDOW_KEY=Wmid
GNN_EDGE_BACKEND=postgres
AI_INFERENCE_ALLOW_HEURISTIC_FALLBACK=true
EDGE_SYNC_MIN_RISK=45
EDGE_SYNC_BATCH_SIZE=200
EDGE_SYNC_LOOKBACK_HOURS=4
EDGE_SYNC_INTERVAL_SECONDS=120
EDGE_GRAPH_INTERVAL_SECONDS=300
EDGE_INFERENCE_INTERVAL_SECONDS=300
EDGE_PATTERN_INTERVAL_SECONDS=300
EDGE_FUSION_INTERVAL_SECONDS=600
