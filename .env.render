# =============================================================================
# Sentinel-KE — Render Production Environment Variables
# =============================================================================
#
# HOW TO USE:
#   1. Go to Render dashboard → your service → Environment
#   2. Set every variable marked [REQUIRED] before first deploy
#   3. Variables marked [AUTO] are generated by render.yaml — do not set manually
#   4. Variables marked [OPTIONAL] can be left blank to use defaults
#
# Generate secret values with:
#   openssl rand -hex 32
# =============================================================================


# =============================================================================
# [REQUIRED] — Must be set in Render dashboard before first deploy
# =============================================================================

# JWT signing secret (openssl rand -hex 32)
AUTH_TOKEN_SECRET=

# TOTP/MFA master secret (openssl rand -hex 32)
AUTH_MFA_SECRET_KEY=

# Password hashing pepper (openssl rand -hex 32)
AUTH_PASSWORD_PEPPER=

# First admin user password (set a strong password, change after first login)
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Your frontend URL(s) — comma-separated, no trailing slash
# Example: https://sentinel-ke.vercel.app,https://sentinel-ke.netlify.app
CORS_ALLOW_ORIGINS=

# Legal approver secrets for evidence signing
# Format: approver_a=secret_a,approver_b=secret_b
LEGAL_APPROVER_SECRETS=approver_a=change-me-a,approver_b=change-me-b


# =============================================================================
# [AUTO] — Generated by render.yaml, do not override
# =============================================================================

# DATABASE_URL         ← injected from Render Postgres
# FRONTEND_API_KEY     ← auto-generated
# INGEST_API_KEY       ← auto-generated
# PSEUDONYM_SALT       ← auto-generated


# =============================================================================
# [FIXED] — Set by render.yaml, listed here for reference
# =============================================================================

APP_ENV=production
DB_AUTO_CREATE=true
KAFKA_ENABLED=false
GNN_ENABLED=true
AI_API_ENABLED=true
GNN_EDGE_BACKEND=postgres
API_AUTH_DISABLED=false
AUTH_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Sentinel Admin
AUTH_TOKEN_ISSUER=sentinel-ke-auth
AUTH_TOKEN_AUDIENCE=sentinel-ke-api
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_REFRESH_TOKEN_MINUTES=10080
AUTH_CENTRAL_MFA_REQUIRED=false
HTTP_SECURITY_HEADERS_ENABLED=true
HTTP_REQUEST_LOGGING_ENABLED=true
MINIO_ANCHOR_MODE=stub
IMMUDB_ANCHOR_MODE=stub
OPENSEARCH_HOST=disabled
GNN_ARTIFACT_DIR=/app/artifacts/gnn
GNN_EPOCHS=60


# =============================================================================
# [OPTIONAL] — External services (leave blank to disable)
# =============================================================================

# Neo4j Aura (free tier: https://neo4j.com/cloud/platform/aura-graph-database/)
# Leave blank to use Postgres-only graph edges (GNN_EDGE_BACKEND=postgres)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Upstash Kafka (free tier: https://upstash.com/kafka) — leave blank to disable
# KAFKA_ENABLED=true
# REDPANDA_BROKERS=your-upstash-bootstrap-server:9092
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# AI Lineage signing (leave blank to disable signing)
AI_LINEAGE_SIGNING_SECRET=


# =============================================================================
# GNN Tuning (optional overrides)
# =============================================================================

GNN_HIDDEN_DIM=64
GNN_EMBED_DIM=32
GNN_DROPOUT=0.2
GNN_LEARNING_RATE=0.001
GNN_EPOCHS=60
RETRAIN_INTERVAL_SEC=3600
RETRAIN_EPOCHS=30


# =============================================================================
# AFTER FIRST SUCCESSFUL DEPLOY:
# =============================================================================
#
# 1. Log in at POST /auth/login with:
#      username: admin
#      password: <AUTH_BOOTSTRAP_ADMIN_PASSWORD>
#
# 2. Create API keys for your frontend:
#      The FRONTEND_API_KEY is auto-generated and visible in Render → Environment
#      Pass it as:  X-API-Key: <FRONTEND_API_KEY>   header from frontend
#
# 3. Check GNN training status:
#      GET /health
#      → { "status": "ok", "gnn_loaded": true, "gnn_model_version": "..." }
#
# 4. Optionally set DB_AUTO_CREATE=false and use Alembic for future migrations:
#      cd backend && alembic upgrade head
# =============================================================================
